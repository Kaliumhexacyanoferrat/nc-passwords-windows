<Application x:Class="NcPasswords.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NcPasswords.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:StringToVisibilityConverter x:Key="StringToVisibility" />
            <local:CountToVisibilityConverter x:Key="CountToVisibility" />

            <Style TargetType="Window">
                <Setter Property="Icon" Value="pack://application:,,,/Assets/app.ico" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
