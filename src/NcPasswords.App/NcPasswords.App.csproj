<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NcPasswords.App</RootNamespace>
    <AssemblyName>NcPasswords</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NcPasswords.Core\NcPasswords.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds this as an implicit global using, which collides with
         System.Windows types (MessageBox, Application, ...) used throughout the app.
         TrayIcon.cs references System.Windows.Forms explicitly via an alias instead. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
