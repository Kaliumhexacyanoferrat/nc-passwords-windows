<Window x:Class="NcPasswords.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in — Nextcloud Passwords"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="460" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sign in to Nextcloud" Style="{StaticResource HeaderText}" />

        <TextBlock Grid.Row="1" Text="Server URL" Style="{StaticResource LabelText}" />
        <TextBox Grid.Row="2" Margin="{StaticResource FieldMargin}"
                 Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="e.g. https://cloud.example.com" />

        <TextBlock Grid.Row="3" Text="Username" Style="{StaticResource LabelText}" />
        <TextBox Grid.Row="4" Margin="{StaticResource FieldMargin}"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="5">
            <TextBlock Style="{StaticResource LabelText}">
                <Run Text="Password (use an " /><Run Text="app password" FontStyle="Italic" /><Run Text=" if 2FA is enabled)" />
            </TextBlock>
            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,4" KeyDown="PasswordBox_KeyDown" />
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,4,0,0">
            <TextBlock Style="{StaticResource LabelText}">
                <Run Text="Additional local password " /><Run Text="(optional)" FontStyle="Italic" />
            </TextBlock>
            <PasswordBox x:Name="UnlockPasswordBox" Margin="0,4,0,4" KeyDown="PasswordBox_KeyDown" />
            <TextBlock Text="If set, NcPasswords asks for this password every time it starts, so your saved data on this PC can't be read without it - not even by other apps running under your Windows account."
                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="7" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap"
                    VerticalAlignment="Top" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />

        <DockPanel Grid.Row="8">
            <ProgressBar DockPanel.Dock="Left" Width="20" Height="20" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,10,0" />
            <Button Content="Sign in" Click="SignIn_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    HorizontalAlignment="Right" Padding="16,6" />
        </DockPanel>
    </Grid>
</Window>
