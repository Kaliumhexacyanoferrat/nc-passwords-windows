<Window x:Class="NcPasswords.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in — NcPasswords"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <StackPanel Margin="32,28,32,22">

        <!-- App logo: white padlock on a Nextcloud-blue tile, drawn as vectors so it stays sharp at any scaling. -->
        <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
            <Viewbox.Effect>
                <DropShadowEffect Color="{StaticResource BrandColor}" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.3" />
            </Viewbox.Effect>
            <Canvas Width="512" Height="512">
                <Rectangle Width="512" Height="512" RadiusX="112" RadiusY="112">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0A8DD3" Offset="0" />
                            <GradientStop Color="#0074B8" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Path Stroke="White" StrokeThickness="38" Data="M 194,262 L 194,226 A 62,63 0 0 1 318,226 L 318,262" />
                <Rectangle Canvas.Left="137" Canvas.Top="255" Width="238" Height="193" RadiusX="30" RadiusY="30" Fill="White" />
                <Ellipse Canvas.Left="233" Canvas.Top="305" Width="46" Height="46" Fill="#0080C6" />
                <Path Fill="#0080C6" Data="M 247,340 L 265,340 L 262,408 L 250,408 Z" />
            </Canvas>
        </Viewbox>

        <TextBlock Text="Welcome to NcPasswords" Margin="0,16,0,0" HorizontalAlignment="Center"
                   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="23" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" />
        <TextBlock Text="Your Nextcloud passwords, right on your desktop." Margin="0,4,0,22"
                   HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedBrush}" />

        <!-- Shown e.g. after upgrading from a version that stored the account password. -->
        <Border Style="{StaticResource InfoCallout}"
                Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="14"
                           Foreground="{StaticResource BrandDarkBrush}" Margin="0,2,10,0" />
                <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{StaticResource InkBrush}" LineHeight="18" />
            </DockPanel>
        </Border>

        <!-- Form card. The shadow sits on a separate layer so it doesn't blur the text. -->
        <Grid>
            <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="#0B2A4A" BlurRadius="24" ShadowDepth="3" Direction="270" Opacity="0.08" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" Padding="22,20,22,22">
                <StackPanel>
                    <TextBlock Text="Nextcloud server" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ServerUrlBox" Style="{StaticResource InputTextBox}"
                             Tag="https://cloud.example.com"
                             Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,6">
                        <Run Text="Local password" />
                        <Run Text="(optional)" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <PasswordBox x:Name="UnlockPasswordBox" Style="{StaticResource InputPasswordBox}"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="Asked every time NcPasswords starts, so your saved data can't be read without it - not even by other apps running under your Windows account." />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource ErrorCallout}" Margin="0,16,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE783;" FontSize="14"
                           Foreground="#C4314B" Margin="0,2,10,0" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="#7A1E2B" LineHeight="18" />
            </DockPanel>
        </Border>

        <Button Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Click="SignIn_Click" IsDefault="True"
                Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sign in with browser" />
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" FontSize="12" FontWeight="Normal"
                           Margin="10,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Progress while connecting and while the user approves access in the browser. -->
        <Border Style="{StaticResource InfoCallout}" Margin="0,18,0,0" Padding="14,12"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource GhostButton}"
                            Command="{Binding CancelCommand}" IsCancel="True" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Waiting for your browser" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource InkBrush}"
                                   Visibility="{Binding IsWaitingForBrowser, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding IsWaitingForBrowser, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Log in and grant access on your Nextcloud page." />
                            <Hyperlink Style="{StaticResource BrandLink}" Command="{Binding OpenBrowserCommand}">Open it again</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Connecting to your Nextcloud…" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource InkBrush}"
                                   Visibility="{Binding IsWaitingForBrowser, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0" BorderThickness="0"
                             Foreground="{StaticResource BrandBrush}" Background="#CDE7F6" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource HintText}" TextAlignment="Center" Margin="8,20,8,0">
            <Run FontFamily="{StaticResource IconFont}" Text="&#xE72E;" />
            <Run Text=" NcPasswords never sees your Nextcloud password. It gets an app password you can revoke anytime under Settings → Security." />
        </TextBlock>
    </StackPanel>
</Window>
